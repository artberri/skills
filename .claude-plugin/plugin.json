{
	"name": "artberri",
	"description": "Alberto Varela's portable agent skills and agents: committing, PR review with Open Code Review, and adapting skill templates to a project.",
	"author": {
		"name": "Alberto Varela Sánchez"
	},
	"license": "MIT",
	"skills": ["./skills/portable/"],
	"agents": ["./agents/portable/ocr-reviewer.md"],
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "OCR_REVIEW_OFFER=\"${OCR_REVIEW_OFFER:-0}\" \"${CLAUDE_PLUGIN_ROOT}/skills/portable/ocr-review/hooks/ocr-review-offer.sh\""
					}
				]
			}
		]
	}
}
